+/*
+ * GE_HOST_PORT: the Huffman pool is sized in BYTES for an 8-byte `struct huft`.
+ * That union holds a `struct huft *`, so the entry is 8 bytes on the N64 and
+ * 16 on a 64-bit host -- the same entries then need twice the space and
+ * silently overrun this array. Scaled by the real entry size so the ENTRY count
+ * is what stays fixed, which is the thing the decompressor actually bounds.
+ * The N64 declaration below is untouched, so `make` is unaffected.
+ * See patches/HOST-PORT-PATCHES.md 17.
+ */
+#ifdef GE_HOST_PORT
+    u8  buffer[0x2100 * (sizeof(void *) / 4)];
+#else
     u8  buffer[0x2100];
+#endif
     s32 unused;
 
 
