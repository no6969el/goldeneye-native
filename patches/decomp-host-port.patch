@@ -291,8 +291,29 @@
   @exception: AI_LIST_ID Must NOT be a BG List (10XX)
               THIS must be defined for this function to be able to return
 ******************************************************************************/
+/*
+ * HOST BUILD: the trailing comma is dropped.
+ *
+ * The false branch already ends in a comma -- SetChrAiList() emits one -- and
+ * this macro adds another, so the host preprocessor produces `... 0x00FF , ,`
+ * and the array initializer has an empty element. IDO produces a single comma
+ * from the same macro: its deferred-expansion (DEFER/EVAL) rescan behaves
+ * differently, and the deferred COMMA never materializes on top of the one the
+ * command already emitted.
+ *
+ * Only the true branch (AI_ERR_NO_THIS, the deliberate "you forgot to #define
+ * THIS" diagnostic) needs the extra comma, and that branch is a compile error
+ * by design. So the N64 macro below is left byte-identical and only the host
+ * variant differs.
+ */
+#ifndef TARGET_N64
+#define CALL(AI_LIST_ID)  \
+                                  IF_ELSE (  DEFINED (  THIS )                     )  (  AI_ERR_NO_THIS   )  (  (                    SetReturnAiList(THIS)SetChrAiList(CHR_SELF, (!isBGAIListID(AI_LIST_ID) && isSubroutine(AI_LIST_ID) ? AI_LIST_ID : AI_ERR_NOTSUB)) )  )  
+#else
 #define CALL(AI_LIST_ID)  \
                                   IF_ELSE (  DEFINED (  THIS )                     )  (  AI_ERR_NO_THIS   )  (  (                    SetReturnAiList(THIS)SetChrAiList(CHR_SELF, (!isBGAIListID(AI_LIST_ID) && isSubroutine(AI_LIST_ID) ? AI_LIST_ID : AI_ERR_NOTSUB)) )  )  ,
+#endif
+
 
 
 
