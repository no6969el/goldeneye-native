+/*
+ * The propDef list: the last big-endian section of the setup file, and the one
+ * that cannot be converted in place.
+ *
+ * WHY THIS ONE IS DIFFERENT
+ *
+ * Every other list in the file is a struct pinned with GE_N64PTR, so the host
+ * layout matches the cartridge byte for byte and geSwap_*() can convert it where
+ * it lies. These records cannot be pinned: src/game/gobjdata.c and its siblings
+ * are static initializer tables of ObjectRecord and friends, and clang will not
+ * put an address-space-cast pointer in a static initializer -- 12 files and 525
+ * undefined symbols, measured, in tools/pin_structs.py.
+ *
+ * So ObjectRecord is 128 bytes on the cartridge and 144 here: `prop` and `model`
+ * are four bytes there and eight here, and everything from 0x10 onward moves.
+ * sizepropdef() -- which the game itself uses to stride the list -- returns the
+ * HOST size, so the game strides 144 bytes through 128-byte records. Thirty
+ * records in, it read a prop ID out of the middle of its predecessor and asked
+ * modelLoad() for model 7936.
+ *
+ * WHAT THIS DOES
+ *
+ * Builds a second list. Each record is read at its cartridge stride and written
+ * at the host stride, field by field, by the generated geExpand_*() in
+ * src/host/ge_expand.c -- which locates every leaf in BOTH layouts, from two
+ * DWARF builds of these same headers, and pairs them by path. The rest of the
+ * game then walks the new list with sizepropdef() and is right, because the new
+ * list is laid out the way sizepropdef() describes.
+ *
+ * The two strides are not simply sizeof-there and sizeof-here. sizepropdef()
+ * returns hand-written word constants for a dozen types -- 0x3b for a CCTV
+ * where the struct is 63 words -- and the FILE is packed at whatever that
+ * function says, on the N64 as here. So the file stride and the memory stride
+ * are the same constant for those, and only the sizeof-derived ones differ.
+ * geFilePropDefBytes() and sizepropdef() keep the two questions apart; both
+ * read the one table in hostcompat/ge_propdef_sizes.h.
+ *
+ * A record whose type has no generated expander is copied word-swapped: those
+ * are the short objective records, which are runs of 32-bit ids and counts with
+ * no sub-word field and no pointer, so the two layouts are already identical.
+ */
+
+/*
+ * The record's size IN THE FILE.
+ *
+ * sizepropdef() answers the other question -- how far apart to place the
+ * records in memory, which on the host is the larger of Rare's constant and the
+ * host sizeof. Both come from the one table in hostcompat/ge_propdef_sizes.h so
+ * they cannot drift apart.
+ */
+static unsigned int geFilePropDefBytes(unsigned int type)
+{
+    switch (type) {
+#define GE_PROPDEF_FILEWORDS(tag, words, T) case tag: return (words) * 4u;
+#define GE_PROPDEF_FILEWORDS_P(tag, words)  case tag: return (words) * 4u;
+    GE_PROPDEF_TABLE(GE_PROPDEF_FILEWORDS)
+    GE_PROPDEF_TABLE_PLAIN(GE_PROPDEF_FILEWORDS_P)
+#undef GE_PROPDEF_FILEWORDS
+#undef GE_PROPDEF_FILEWORDS_P
+    default:
+        /* sizepropdef()'s own default: one header word. */
+        return (unsigned int)sizeof(PropDefHeaderRecord);
+    }
+}
+
+static void geExpandSetupAiLists(struct stagesetup *setup)
+{
+    const unsigned char *src = (const unsigned char *)g_CurrentSetup.ailists;
+    AIListRecord *out;
+    unsigned int n = 0;
+
+    (void)setup;
+    if (src == NULL) {
+        return;
+    }
+    /* Terminated by a zero pointer word. Byte order does not matter for the
+       test -- a byte-reversed zero is still zero -- so the count can be taken
+       before anything is converted. */
+    while (n < 65536u) {
+        const unsigned char *e = src + n * 8u;
+        if (e[0] == 0 && e[1] == 0 && e[2] == 0 && e[3] == 0) {
+            break;
+        }
+        ++n;
+    }
+
+    out = mempAllocBytesInBank((n + 1u) * (unsigned int)sizeof(AIListRecord),
+                               MEMPOOL_STAGE);
+    if (out == NULL) {
+        return;
+    }
+    memset(out, 0, (n + 1u) * sizeof(AIListRecord));
+    {
+        unsigned int i;
+        for (i = 0; i < n; ++i) {
+            const unsigned char *e = src + i * 8u;
+            unsigned int off = ((unsigned int)e[0] << 24) | ((unsigned int)e[1] << 16)
+                             | ((unsigned int)e[2] << 8)  | ((unsigned int)e[3]);
+            out[i].ailist = (void *)(unsigned long)off;   /* still file-relative */
+            out[i].ID = (int)(((unsigned int)e[4] << 24) | ((unsigned int)e[5] << 16)
+                            | ((unsigned int)e[6] << 8)  | ((unsigned int)e[7]));
+        }
+    }
+    g_CurrentSetup.ailists = out;
+}
+
+/*
+ * bondtypes.h gives some intro records a typedef and leaves the rest as plain
+ * struct tags, so `sizeof(T)` in the table below does not compile for seven of
+ * the ten. Named here rather than by carrying a `struct`-or-not column through
+ * GE_INTRO_TABLE: the generated geExpand_*() names use the bare tag either way,
+ * so this is the only place the difference shows up.
+ */
+typedef struct SetupIntroItem    SetupIntroItem;
+typedef struct SetupIntroAmmo    SetupIntroAmmo;
+typedef struct SetupIntroSwirl   SetupIntroSwirl;
+typedef struct SetupIntroAnim    SetupIntroAnim;
+typedef struct SetupIntroCuff    SetupIntroCuff;
+typedef struct SetupIntroWatch   SetupIntroWatch;
+typedef struct SetupIntroCredits SetupIntroCredits;
+
+/*
+ * The setup file's INTRO section: the second type-tagged, variable-length list.
+ *
+ * Same shape as the propDef records and the same two-stride problem, with two
+ * differences worth naming:
+ *
+ *   - the tag is a full s32 at offset 0, not a byte at offset 3, so it has to
+ *     be read big-endian before anything is converted;
+ *   - only ONE record type actually changes shape. Every other intro record is
+ *     a run of s32 and is the same size on both machines; SetupIntroCamera has
+ *     two `union { integer; char *; }` members and a `prev` pointer, so it is
+ *     40 bytes on the cartridge and 56 here.
+ *
+ * That one type is enough to require rebuilding the whole list, because
+ * bondviewLoadSetupIntroSection strides by `sizeof` and a single camera record
+ * puts everything after it 16 bytes out. It is also why this was invisible
+ * until the propDef work landed: the level never got far enough to walk the
+ * intro list, and when it did, langGet took a null bank -- the camera's
+ * `lang1c.lang_index[1]` was being read out of the middle of the record before
+ * it.
+ */
+static unsigned int geIntroFileBytes(unsigned int type)
+{
+    switch (type) {
+#define GE_INTRO_SZ(tag, T) case tag: return GE_N64SIZEOF_##T;
+    GE_INTRO_TABLE(GE_INTRO_SZ)
+#undef GE_INTRO_SZ
+    default:
+        /* What the walker's own default does: skip one word and carry on. */
+        return (unsigned int)GE_N64SIZEOF_SetupIntroEmpty;
+    }
+}
+
+static void geExpandSetupIntro(struct stagesetup *setup)
+{
+    const unsigned char *src;
+    unsigned char *dst = NULL, *out;
+    unsigned int total = 0;
+    unsigned int pass;
+
+    (void)setup;
+    if (g_CurrentSetup.intro == NULL) {
+        return;
+    }
+
+    for (pass = 0; pass < 2u; ++pass) {
+        unsigned int guard;
+        src = (const unsigned char *)g_CurrentSetup.intro;
+        out = (pass == 0u) ? NULL : dst;
+        total = 0;
+
+        for (guard = 0; guard < 65536u; ++guard) {
+            void (*fn)(void *, const void *) = NULL;
+            unsigned int hostbytes = 0, filebytes;
+            unsigned int type = ((unsigned int)src[0] << 24)
+                              | ((unsigned int)src[1] << 16)
+                              | ((unsigned int)src[2] << 8)
+                              | ((unsigned int)src[3]);
+
+            if (type == (unsigned int)INTROTYPE_END) {
+                if (out != NULL) {
+                    /* Written as a value, not copied: the walkers read
+                       `intro_record->type` as a native s32. */
+                    ((SetupIntroEmpty *)(void *)out)->type = INTROTYPE_END;
+                }
+                total += 4u;
+                break;
+            }
+
+            filebytes = geIntroFileBytes(type);
+            switch (type) {
+#define GE_INTRO_CASE(tag, T)                                                  \
+            case tag: fn = geExpand_##T;                                       \
+                      hostbytes = (unsigned int)sizeof(T); break;
+            GE_INTRO_TABLE(GE_INTRO_CASE)
+#undef GE_INTRO_CASE
+            default:
+                fn = geExpand_SetupIntroEmpty;
+                hostbytes = (unsigned int)sizeof(SetupIntroEmpty);
+                break;
+            }
+
+            if (out != NULL) {
+                fn(out, src);
+                out += hostbytes;
+            }
+            total += hostbytes;
+            src += filebytes;
+        }
+
+        if (pass == 0u) {
+            dst = mempAllocBytesInBank(total, MEMPOOL_STAGE);
+            if (dst == NULL) {
+                return;
+            }
+            memset(dst, 0, total);
+        }
+    }
+
+    g_CurrentSetup.intro = (void *)dst;
+}
+
+static void geSwapSetupPropDefs(struct stagesetup *setup)
+{
+    const unsigned char *src;
+    unsigned char *dst, *out;
+    unsigned int total = 0;
+    unsigned int guard;
+    unsigned char sbuf[1024];   /* one record in the cartridge layout */
+    unsigned char dbuf[1024];   /* the same record in the host layout  */
+
+    if (setup == NULL || g_CurrentSetup.propDefs == NULL) {
+        return;
+    }
+
+    /* Two passes, because the list has to be measured before it can be
+       allocated and the measurement is the same walk. */
+    for (guard = 0; guard < 2u; ++guard) {
+        unsigned int pass;
+        src = (const unsigned char *)g_CurrentSetup.propDefs;
+        out = (guard == 0u) ? NULL : dst;
+        total = 0;
+
+        for (pass = 0; pass < 65536u; ++pass) {
+            void (*fn)(void *, const void *) = NULL;
+            unsigned int structsize = 0;
+            unsigned int type = src[3];
+            unsigned int hostbytes, n64bytes, keep;
+            unsigned int i;
+            s32 words;
+
+            if (type == PROPDEF_END) {
+                if (out != NULL) {
+                    /* The terminator itself: one word whose only live byte is
+                       the tag. Written rather than copied, so the new list ends
+                       the way the walkers expect even if the file's last word
+                       carries something else in its other three bytes. */
+                    out[0] = 0; out[1] = 0; out[2] = 0;
+                    out[3] = (unsigned char)PROPDEF_END;
+                }
+                total += 4u;
+                break;
+            }
+
+            words = sizepropdef((PropDefHeaderRecord *)(void *)(unsigned long)(unsigned char *)src);
+            if (words <= 0) {
+                break;
+            }
+            hostbytes = (unsigned int)words * 4u;
+            n64bytes = geFilePropDefBytes(type);
+
+#define GE_PROPDEF_CASE(tag, T)                                                \
+            case tag: fn = geExpand_##T;                                       \
+                      structsize = (unsigned int)sizeof(T); break;
+#define GE_PROPDEF_CASE_S(tag, T)                                              \
+            case tag: fn = geExpand_##T;                                       \
+                      structsize = (unsigned int)sizeof(struct T); break;
+
+            switch (type) {
+            GE_PROPDEF_CASE(PROPDEF_DOOR,              DoorRecord)
+            GE_PROPDEF_CASE(PROPDEF_DOOR_SCALE,        GlobalDoorScaleRecord)
+            GE_PROPDEF_CASE(PROPDEF_PROP,              ObjectRecord)
+            GE_PROPDEF_CASE(PROPDEF_KEY,               KeyRecord)
+            GE_PROPDEF_CASE(PROPDEF_ALARM,             ObjectRecord)
+            GE_PROPDEF_CASE(PROPDEF_CCTV,              CCTVRecord)
+            GE_PROPDEF_CASE(PROPDEF_MAGAZINE,          AmmoCrateRecord)
+            GE_PROPDEF_CASE(PROPDEF_COLLECTABLE,       WeaponObjRecord)
+            GE_PROPDEF_CASE(PROPDEF_GUARD,             GuardRecord)
+            GE_PROPDEF_CASE(PROPDEF_MONITOR,           MonitorObjRecord)
+            GE_PROPDEF_CASE(PROPDEF_MULTI_MONITOR,     MultiMonitorObjRecord)
+            GE_PROPDEF_CASE(PROPDEF_RACK,              ObjectRecord)
+            GE_PROPDEF_CASE(PROPDEF_AUTOGUN,           AutogunRecord)
+            GE_PROPDEF_CASE(PROPDEF_LINK,              LinkRecord)
+            GE_PROPDEF_CASE(PROPDEF_HAT,               HatRecord)
+            GE_PROPDEF_CASE(PROPDEF_GUARD_ATTRIBUTE,   GuardAttributeRecord)
+            /* Switch is typedef'd to LinkRecord; see sizepropdef's own note. */
+            GE_PROPDEF_CASE(PROPDEF_SWITCH,            LinkRecord)
+            GE_PROPDEF_CASE(PROPDEF_AMMO,              MultiAmmoCrateRecord)
+            GE_PROPDEF_CASE(PROPDEF_ARMOUR,            BodyArmourRecord)
+            GE_PROPDEF_CASE(PROPDEF_TAG,               TagObjectRecord)
+            GE_PROPDEF_CASE(PROPDEF_GAS_RELEASING,     GasReleasingRecord)
+            GE_PROPDEF_CASE(PROPDEF_RENAME,            RenameObjectRecord)
+            GE_PROPDEF_CASE(PROPDEF_LOCK_DOOR,         LockDoorRecord)
+            GE_PROPDEF_CASE(PROPDEF_VEHICHLE,          VehichleRecord)
+            GE_PROPDEF_CASE(PROPDEF_AIRCRAFT,          AircraftRecord)
+            GE_PROPDEF_CASE(PROPDEF_GLASS,             GlassRecord)
+            GE_PROPDEF_CASE(PROPDEF_SAFE,              SafeRecord)
+            GE_PROPDEF_CASE(PROPDEF_SAFE_ITEM,         SafeObjectRecord)
+            GE_PROPDEF_CASE(PROPDEF_TANK,              TankRecord)
+            GE_PROPDEF_CASE(PROPDEF_CAMERAPOS,         CutsceneRecord)
+            GE_PROPDEF_CASE(PROPDEF_TINTED_GLASS,      TintedGlassRecord)
+            GE_PROPDEF_CASE_S(PROPDEF_OBJECTIVE_START, objective_entry)
+            GE_PROPDEF_CASE_S(PROPDEF_OBJECTIVE_ENTER_ROOM,
+                                                       criteria_roomentered)
+            GE_PROPDEF_CASE_S(PROPDEF_OBJECTIVE_DEPOSIT_OBJECT_IN_ROOM,
+                                                       criteria_deposit)
+            GE_PROPDEF_CASE_S(PROPDEF_OBJECTIVE_PHOTOGRAPH,
+                                                       criteria_picture)
+            GE_PROPDEF_CASE_S(PROPDEF_WATCH_MENU_OBJECTIVE_TEXT,
+                                                       setup_objective_text)
+            default:
+                /* All-word records: the short objective ones. Their two layouts
+                   are identical, so a word swap is the whole conversion.
+                   Anything added to sizepropdef() that is NOT all-word belongs
+                   in the table above -- reaching here would be silent. */
+                break;
+            }
+#undef GE_PROPDEF_CASE
+#undef GE_PROPDEF_CASE_S
+
+            if (out != NULL) {
+                if (fn == NULL || structsize > sizeof(dbuf)
+                        || n64bytes > sizeof(sbuf)) {
+                    unsigned int n = (n64bytes < hostbytes) ? n64bytes : hostbytes;
+                    memset(out, 0, hostbytes);
+                    memcpy(out, src, n);
+                    /*
+                     * Word 0 is the HEADER -- `u16 extrascale; u8 state;
+                     * u8 type` -- so only its leading u16 turns over; the two
+                     * bytes keep their positions. Swapping it as a word moves
+                     * the type tag from offset 3 to offset 0, and the tag is
+                     * what every walker strides by: the game then read a size
+                     * for the wrong type, fell four bytes behind this list, and
+                     * handed domakedefaultobj a record that started mid-header.
+                     * Its pad came out as 256 in a level with 178 pads.
+                     */
+                    if (n >= 4u) {
+                        geSwap16(out);
+                    }
+                    for (i = 4u; i + 4u <= n; i += 4u) {
+                        geSwap32(out + i);
+                    }
+                } else {
+                    /* Through scratch, because the two strides disagree in both
+                       directions: a record can be shorter in the file than the
+                       struct that describes it, and the constant sizepropdef()
+                       returns can be shorter than the struct as well. Neither
+                       the read nor the write may run past its own record. */
+                    /* The whole buffer, not just n64bytes: geExpand_() reads
+                       every field of the struct, and a record that is shorter
+                       in the file than the struct is common here. Zeroing the
+                       tail is what makes those fields zero rather than the
+                       previous record's. */
+                    memset(sbuf, 0, sizeof(sbuf));
+                    memcpy(sbuf, src, n64bytes);
+                    fn(dbuf, sbuf);
+                    keep = (hostbytes < structsize) ? hostbytes : structsize;
+                    memset(out, 0, hostbytes);
+                    memcpy(out, dbuf, keep);
+                }
+                if (getenv("GE_PROPDEF_TRACE")) {
+                    fprintf(stderr, "[pd] %p t=%2u n64=%3u host=%3u src %02X%02X%02X%02X %02X%02X%02X%02X"
+                            "  dst %02X%02X%02X%02X %02X%02X%02X%02X\n",
+                            (void *)out, type, n64bytes, hostbytes,
+                            src[0],src[1],src[2],src[3],src[4],src[5],src[6],src[7],
+                            out[0],out[1],out[2],out[3],out[4],out[5],out[6],out[7]);
+                }
+                out += hostbytes;
+            }
+            total += hostbytes;
+            src += n64bytes;
+        }
+
+        if (guard == 0u) {
+            dst = mempAllocBytesInBank(total, MEMPOOL_STAGE);
+            if (getenv("GE_PROPDEF_TRACE")) {
+                fprintf(stderr, "[propdef] file %p, list %p, new %p..%p (%u bytes)\n",
+                        (void *)setup, (void *)g_CurrentSetup.propDefs,
+                        (void *)dst, (void *)(dst + total), total);
+            }
+            if (dst == NULL) {
+                return;         /* the walk below would read the file layout */
+            }
+            memset(dst, 0, total);
+        }
+    }
+
+    /*
+     * The list has to be walkable BY THE GAME'S OWN RULE, which is the only
+     * property that matters: sizepropdef() reads the type tag at offset 3 and
+     * every walker in the game strides by what it returns. Walking the finished
+     * list that way and checking it lands exactly on the terminator catches a
+     * record written at the wrong stride, or one whose tag did not survive the
+     * conversion -- which is how a word-swapped header put the tag at offset 0
+     * and left the game four bytes behind this list.
+     */
+    {
+        const unsigned char *q = dst;
+        unsigned int walked = 0;
+        while (walked + 4u <= total && q[3] != (unsigned char)PROPDEF_END) {
+            s32 w = sizepropdef((PropDefHeaderRecord *)(void *)(unsigned long)
+                                (unsigned char *)q);
+            if (w <= 0) {
+                break;
+            }
+            walked += (unsigned int)w * 4u;
+            q = dst + walked;
+        }
+        if (walked + 4u != total) {
+            fprintf(stderr,
+                    "[ge-propdef] the converted list does not walk: sizepropdef "
+                    "reaches %u of %u bytes.\n  A record was written at the "
+                    "wrong stride, or its type tag did not survive.\n",
+                    walked + 4u, total);
+        }
+    }
+
+    g_CurrentSetup.propDefs = (void *)dst;
+}
+#endif
