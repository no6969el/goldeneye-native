                CASE1, CASE_VAL1, CASE_CONTENT1,\
@@ -4509,4 +4548,3 @@ IF_VA(NOT(IS_EMPTY(CASE_VAL0)))(IF_VA(NOT(IS_EMPTY(CASE_VAL1)))(BREAK(FAIL_LBL)
