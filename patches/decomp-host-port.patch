+ * GE_HOST_PORT: these two are a SECOND VIEW of ALBank and ALInstrument, over
+ * the very same cartridge bytes that alBnkfNew() patches through the real
+ * types. libaudio.h's ALBank and ALInstrument are pinned to 4-byte pointers so
+ * their host layout matches the N64's; these were not, so the same bank read
+ * through this view had instArray at a different offset and an 8-byte stride.
+ *
+ * sndPlaySfx() therefore loaded instArray[0] as zero and indexed soundArray off
+ * it, faulting at 0x820 = 16 + 258*8 -- the giveaway being that 8, where the
+ * pinned view strides by 4.
+ *
+ * Pinning them is not an alternative layout, it is the SAME layout the patcher
+ * already wrote. See hostcompat/ge_n64ptr.h.
+ */
 struct ALInstrumentAlt_s
 {
     s32 unk0;
     s32 unk4;
     s32 unk8;
-    ALSound *soundArray[1];
+    ALSound * GE_N64PTR soundArray[1];
 };
 
 struct ALBankAlt_s
@@ -168,8 +182,8 @@ struct ALBankAlt_s
     u8 flags;
     u8 pad;
     s32 sampleRate;             /* e.g. 44100, 22050, etc...       */
-    ALInstrument *percussion;   /* default percussion for GM       */
-    struct ALInstrumentAlt_s *instArray[1]; /* ARRAY of instruments            */
+    ALInstrument * GE_N64PTR percussion;   /* default percussion for GM       */
+    struct ALInstrumentAlt_s * GE_N64PTR instArray[1]; /* ARRAY of instruments            */
 };
 
 // end Alternate defintion for ALInstrument
