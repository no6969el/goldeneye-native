+/*
+ * SWITCH is padded AT THE CALL SITE, not here -- see src/game/chraidata.c.
+ *
+ * The obvious host fix is the variadic-front-end-plus-padding trick used
+ * elsewhere in this port (HOST-PORT-PATCHES.md section 12):
+ *
+ *     #define SWITCH(VAR, ...) SWITCH_PAD(VAR, __VA_ARGS__, <48 empties>)
+ *
+ * IT IS WRONG HERE, and wrong in a way that still compiles. Substituting
+ * __VA_ARGS__ into another macro's argument list macro-expands it FIRST, so a
+ * case body like
+ *
+ *     PlayAnimation(ANIM_yawning, 0, 193, ...) BREAK
+ *
+ * expands to a comma-separated byte list before SWITCH_I ever separates its
+ * arguments -- and every one of those commas then counts as an argument
+ * separator. One case body becomes six arguments. Measured: a 4-case SWITCH
+ * reached SWITCH_I as 99 arguments instead of 13, and the case content the body
+ * finally saw was the single token `0x10`.
+ *
+ * An object-like alias (`#define SWITCH SWITCH_I`) avoids the extra expansion,
+ * because the source tokens are then separated raw -- but it needs the compiler
+ * to tolerate omitted trailing arguments, which IDO does and standard C does
+ * not.
+ *
+ * So the padding goes where it costs nothing: the four call sites now pass all
+ * 49 arguments explicitly. Both compilers see one fixed-arity macro with a
+ * matching argument count, and no front-end is needed at all.
+ */
 #define SWITCH(VAR, \
                CASE0, CASE_VAL0, CASE_CONTENT0,\
                CASE1, CASE_VAL1, CASE_CONTENT1,\
@@ -4509,4 +4548,3 @@ IF_VA(NOT(IS_EMPTY(CASE_VAL0)))(IF_VA(NOT(IS_EMPTY(CASE_VAL1)))(BREAK(FAIL_LBL)
 #endif
 #endif
 
