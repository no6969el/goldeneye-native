+#ifdef GE_HOST_PORT
+/*
+ * The demo header is CARTRIDGE DATA.
+ *
+ * replay_recorded_ramrom_at_address() DMAs a ramromfilestructure straight out of
+ * the ROM and then reads `stagenum` from it. Big-endian, level 26 (Cuba) arrives
+ * as 0x1A000000, and lvlStageLoad() went looking for a level with that id --
+ * which is where the attract-mode demo died, at frame 3810, four screens after
+ * anything that looked related.
+ *
+ * Written out field by field rather than as a byte-offset table: every member is
+ * a scalar with the same size and alignment on both targets, so taking each
+ * one's ADDRESS lets the compiler compute the offsets and the list cannot drift
+ * out of step with the struct.
+ *
+ * savefile.times[] and the single-byte flags around `options` are deliberately
+ * absent -- they are bytes and already correct. So is everything after the
+ * header: the recorded input stream is a byte sequence.
+ */
+static void geSwapRamromHeader(ramromfilestructure *h)
+{
+    s32 i;
+
+    geSwap64((unsigned char *)&h->randomseed);
+    geSwap64((unsigned char *)&h->randomizer);
+    geSwap32((unsigned char *)&h->stagenum);
+    geSwap32((unsigned char *)&h->difficulty);
+    geSwap32((unsigned char *)&h->size_cmds);
+
+    geSwap32((unsigned char *)&h->savefile.chksum1);
+    geSwap32((unsigned char *)&h->savefile.chksum2);
+    geSwap16((unsigned char *)&h->savefile.options);
+
+    geSwap32((unsigned char *)&h->totaltime_ms);
+    geSwap32((unsigned char *)&h->filesize);
+    geSwap32((unsigned char *)&h->mode);
+    geSwap32((unsigned char *)&h->slotnum);
+    geSwap32((unsigned char *)&h->numplayers);
+    geSwap32((unsigned char *)&h->scenario);
+    geSwap32((unsigned char *)&h->mpstage_sel);
+    geSwap32((unsigned char *)&h->gamelength);
+    geSwap32((unsigned char *)&h->mp_weapon_set);
+    geSwap32((unsigned char *)&h->aim_option);
+
+    for (i = 0; i < 4; i++) {
+        geSwap32((unsigned char *)&h->mp_char[i]);
+        geSwap32((unsigned char *)&h->mp_handi[i]);
+        geSwap32((unsigned char *)&h->mp_contstyle[i]);
+        geSwap32((unsigned char *)&h->mp_flags[i]);
+    }
+}
