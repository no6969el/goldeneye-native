+ * Host: the `#pragma weak` above gives get_status_of_objective a second name,
+ * which src/game/chrai.c:38 declares with TWO parameters and calls with two
+ * arguments -- the "horrible hack to get ai matching" the comment refers to.
+ *
+ * clang rejects uses of a weak alias as ambiguous, and a file-local macro is
+ * not enough here: unlike the aliases in lv.c and spectrum.c, this one is
+ * referenced from another translation unit, so the symbol has to really exist.
+ * A forwarding function provides it and discards the extra argument, which is
+ * what the aliased call did anyway. Defined at the end of the file so
+ * get_status_of_objective is already in scope.
+ */
+s32 objectiveGetStatus_WEAK(s32 objectiveNum, s32 unused)
+{
+    (void)unused;
+    return (s32)get_status_of_objective(objectiveNum);
+}
+#endif
