--- a/src/tlb_manage.c
+++ b/src/tlb_manage.c
@@ -105,7 +105,15 @@ u32 g_tlbmanageMappingTableEnd;
  */
 u8 (*g_tlbmanageTlbAllocatedBlock) [TLB_BLOCK_SIZE];
 
+#ifdef TARGET_N64
 extern u8 *_gameSegmentRomStart;
+#else
+/* Host: these names are macros from hostcompat/ge_segments_compat.h -- see
+   there for why. The declarations below cannot be parsed once the macros are
+   defined, and are not needed, so the N64 path keeps them and the host path
+   takes the header instead. */
+#include <ge_segments_compat.h>
+#endif
 extern u8 *sp_boot;
 
 
@@ -130,7 +138,49 @@ void tlbmanageEstablishManagementTable(void)
         g_tlbMappingTable[i].entry0 = 1;
     }
 
+#ifdef TARGET_N64
     g_tlbmanageTlbAllocatedBlock = (u8(*)[TLB_BLOCK_SIZE]) (((u32)&sp_boot & ~(PAGE_SIZE - 1)) - (MAPPING_TABLE_COUNT * PAGE_SIZE));
+#else
+    /*
+     * Host: this block has to live in RDRAM, and &sp_boot does not.
+     *
+     * On N64 every static is in RDRAM, so placing the TLB paging block just
+     * below the boot stack put it in RDRAM by construction. In this port the
+     * game's statics live in the host executable's BSS, so &sp_boot is around
+     * 0x536000 -- and src/boss.c:218 uses this pointer as the TOP of the main
+     * memory pool:
+     *
+     *     start = PHYS_TO_K0(osVirtualToPhysical(&_bssSegmentEnd));   // 0x8008E360
+     *     mempCheckMemflagTokens(start, (u32)tlbmanageGetTlbAllocatedBlock() - start);
+     *
+     * so the pool ran from RDRAM to a host static, its size underflowed, and
+     * the allocator handed out pointers into the executable's .text. The
+     * symptom was a segfault in memcpy() with a destination inside a FUNCTION
+     * (`fileLoadSettingsForFolder+403`) during language-file loading -- a long
+     * way from anything about memory pools.
+     *
+     * The port does not page through the TLB (src/ultra/os_tlb.c), so this
+     * block is only meaningful here as the ceiling of the heap. Placing it near
+     * the top of the 8 MB window gives the game about 7 MB of RDRAM to allocate
+     * from, which is more than the 4 MB retail machine had.
+     */
+    /*
+     * Reserve only the block itself, not the mapping table behind it.
+     *
+     * The mapping table exists to page data in through the TLB. This port never
+     * does that -- every address is mapped directly -- so those pages are dead
+     * space, and they sat directly below the heap ceiling: 0xB6000 of RDRAM
+     * (745 KB) that nothing could ever use.
+     *
+     * It mattered because MEMPOOL_PERMANENT is carved to end exactly here, and
+     * libaudio's runtime structs are 1.5-2x larger on a 64-bit host. The music
+     * heap needed to grow and had 864 bytes of headroom; the game's own
+     * out-of-memory trap (memp.c:200, `while (1);`) then hung the boot rather
+     * than failing.
+     */
+    g_tlbmanageTlbAllocatedBlock =
+        (u8(*)[TLB_BLOCK_SIZE]) (0x80800000u - TLB_BLOCK_SIZE);
+#endif
     g_tlbmanageMappingTableEnd = ((u32)&g_tlbManagementTable) + 0xFFC08000;
