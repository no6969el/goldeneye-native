+    #ifdef GE_HOST_PORT
+    /* An RDRAM address held in a signed 32-bit value: negative, so
+       widening it back to a pointer sign-extends. See
+       hostcompat/ge_addr_compat.h. Generated by
+       tools/fix_sext_pointer_sites.py from clang's own diagnostic. */
+    ptr_active_demofile = GE_PTR(struct ramromfilestructure *, romCopyAligned(&ramrom_data_target, address_demo_loaded, sizeof(struct ramromfilestructure)));
+    #else
     ptr_active_demofile = romCopyAligned(&ramrom_data_target, address_demo_loaded, sizeof(struct ramromfilestructure));
+    #endif
+#ifdef GE_HOST_PORT
